# Environment variables for AZZAB MOTO
# Copy this file to .env and fill in the values.
# .env is in .gitignore and must NEVER be committed.
# No secrets are used — all values here are public configuration flags.

# Production site URL (used for Open Graph and canonical links)
VITE_SITE_URL=https://azzabmoto.com

# Data source mode: 'json' (static client repository) | 'api' (REST API backend)
# In development, defaults to 'json' if unset.
VITE_DATA_SOURCE=json

# REST API Base URL (required when VITE_DATA_SOURCE=api)
# Example: https://api.azzabmoto.com or http://localhost:3000
VITE_API_BASE_URL=

# Image CDN URL (optional)
# VITE_IMAGE_CDN_URL=https://cdn.azzabmoto.com
