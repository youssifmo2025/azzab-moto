# Environment variables for AZZAB MOTO
# Copy this file to .env and fill in the values.
# .env is in .gitignore and must NEVER be committed.
# No secrets are used in Starter — all values here are optional overrides.

# Production site URL (used for Open Graph and canonical links)
# VITE_SITE_URL=https://azzabmoto.com

# In Phase 7+: if a CDN is added for images, add its origin here
# and update the CSP img-src directive in public/_headers and vercel.json
# VITE_IMAGE_CDN_URL=https://cdn.azzabmoto.com

